# Copy to .env.local and fill in what you have. Nothing here is required
# to run `pnpm lint`/`typecheck`/`test`/`build` — these only matter once
# you're running migrations or the import script against a real database.

# ── Used today ──────────────────────────────────────────────────────

# packages/db/drizzle.config.ts — needed only for `drizzle-kit push`
# against a real database. Not needed for `drizzle-kit generate`, which
# reads schema.ts directly. The College's real Supabase project is
# connected (see packages/db/README.md); this var is for your own local
# Postgres workflow, which stays the documented way to prove a schema
# change before it goes live.
DATABASE_URL=

# packages/db/src/scripts/import-trainees.ts — local path to a copy of
# the College's TP roster spreadsheet. Never commit the file itself; keep
# it under packages/db/data/ (gitignored) or anywhere else outside git.
TRAINEE_REGISTER_PATH=

# packages/db/src/scripts/import-ipt-roster.ts — local path to a copy of
# the College's IPT roster workbook (legacy .xls). Same rule: never
# commit it, keep it under packages/db/data/ or outside git.
IPT_ROSTER_PATH=

# Supabase project (azlwxriyhdshfhklonrx). Both values come from
# Project Settings > API in the Supabase dashboard.
#
# Neither carries the NEXT_PUBLIC_ prefix, deliberately. Nothing in the
# browser reads them: every Supabase call is made server-side, from
# apps/web/src/lib/supabase/server.ts (server components and Server
# Actions) and apps/web/src/middleware.ts. The prefix would inline both
# values into the client bundle for no benefit, so they stay server-only
# and are never shipped to the device.
#
# SUPABASE_ANON_KEY is the publishable/anon key. It is public by design
# and RLS is what actually guards the data — keeping it out of the
# bundle is defence in depth, not the security boundary.
#
# Copy both into apps/web/.env.local, not just the repo root: Next.js
# only reads env files from the app's own directory.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# packages/db/src/scripts/create-accounts.ts and reset-passwords.ts —
# real Supabase Auth accounts (see packages/db/src/data/ipt-accounts.ts).
# Both read SUPABASE_URL above plus the service-role key.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — never sent to the
# client, never held by an agent (AGENTS.md) — run these scripts
# yourself, locally. See packages/db/README.md for which does what.
SUPABASE_SERVICE_ROLE_KEY=

# Result e-mail. apps/web/src/lib/notifications/. Recipients differ by track,
# per the College's decision of 2026-09-05:
#   TP   To the trainee    Cc the assessor    Bcc the Coordinator
#   IPT  To the assessor   Cc the Coordinator
# IPT trainees are never e-mailed at all -- their register holds a phone and no
# address, and they are notified by SMS (CONTEXT.md).
#
# The sending account is the dedicated mvttc.assessment@gmail.com, not anyone's
# personal mailbox: if the sender is locked or flagged, result delivery stops,
# so it must not be an account also used for ordinary mail.
#
# Gmail SMTP, per the College's decision to use the mailboxes it already has.
# This works properly because the From address and the SMTP server belong to
# the same operator: Google DKIM-signs mail sent as you@gmail.com through
# smtp.gmail.com, so it arrives DMARC-aligned. Relaying a gmail.com address
# through a third-party ESP would NOT be -- nobody can add DKIM records to
# gmail.com. Do not "improve" this by pointing SMTP_USER at a Gmail address
# while sending through another provider.
#
# SMTP_PASSWORD is a Google APP PASSWORD (16 characters), never the account
# password: Google withdrew basic password auth for third-party clients in
# 2022. Generating one requires 2-Step Verification on that account
# (https://myaccount.google.com/apppasswords).
#
# SMTP_HOST defaults to smtp.gmail.com and SMTP_PORT to 587 (STARTTLS); set
# 465 for implicit TLS. SMTP_USER is also the From address -- Gmail rewrites
# any other -- so only the display name is ours to choose.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# Optional alternative transport (apps/web/src/lib/notifications/brevo.ts),
# kept for the day the College has a domain of its own. Unused while SMTP_* is
# configured. A sender on an authenticated domain is required -- a free webmail
# address cannot be authenticated in Brevo.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=

RESULT_COORDINATOR_EMAIL=

# ── Not wired up yet — placeholders for when they are ──────────────
# Phase 0 (ROADMAP.md 0.5): Sentry. Not read by any code yet.

# SENTRY_DSN=
