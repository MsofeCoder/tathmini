# Copy to .env.local and fill in what you have. Nothing here is required
# to run `pnpm lint`/`typecheck`/`test`/`build` — these only matter once
# you're running migrations or the import script against a real database.

# ── Used today ──────────────────────────────────────────────────────

# packages/db/drizzle.config.ts — needed only for `drizzle-kit push`
# against a real database. Not needed for `drizzle-kit generate`, which
# reads schema.ts directly. The College's real Supabase project is
# connected (see packages/db/README.md); this var is for your own local
# Postgres workflow, which stays the documented way to prove a schema
# change before it goes live.
DATABASE_URL=

# packages/db/src/scripts/import-trainees.ts — local path to a copy of
# the College's TP roster spreadsheet. Never commit the file itself; keep
# it under packages/db/data/ (gitignored) or anywhere else outside git.
TRAINEE_REGISTER_PATH=

# packages/db/src/scripts/import-ipt-roster.ts — local path to a copy of
# the College's IPT roster workbook (legacy .xls). Same rule: never
# commit it, keep it under packages/db/data/ or outside git.
IPT_ROSTER_PATH=

# Supabase project (azlwxriyhdshfhklonrx). Both values come from
# Project Settings > API in the Supabase dashboard.
#
# Neither carries the NEXT_PUBLIC_ prefix, deliberately. Nothing in the
# browser reads them: every Supabase call is made server-side, from
# apps/web/src/lib/supabase/server.ts (server components and Server
# Actions) and apps/web/src/middleware.ts. The prefix would inline both
# values into the client bundle for no benefit, so they stay server-only
# and are never shipped to the device.
#
# SUPABASE_ANON_KEY is the publishable/anon key. It is public by design
# and RLS is what actually guards the data — keeping it out of the
# bundle is defence in depth, not the security boundary.
#
# Copy both into apps/web/.env.local, not just the repo root: Next.js
# only reads env files from the app's own directory.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# packages/db/src/scripts/create-accounts.ts — real Supabase Auth
# accounts (see packages/db/src/data/ipt-accounts.ts). Reads SUPABASE_URL
# above plus the service-role key. SUPABASE_SERVICE_ROLE_KEY bypasses RLS
# entirely — never sent to the client, never held by an agent
# (AGENTS.md) — run this script yourself, locally.
SUPABASE_SERVICE_ROLE_KEY=

# ── Not wired up yet — placeholders for when they are ──────────────
# Phase 0 (ROADMAP.md 0.5): Sentry. Not read by any code yet.

# SENTRY_DSN=
