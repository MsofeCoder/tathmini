# Real trainee/supervisor data (names, personal e-mail addresses) — never
# committed. Point TRAINEE_REGISTER_PATH at a local copy for import scripts.
packages/db/data/

# Password sheets for `assign:passwords`. These hold LIVE supervisor
# credentials in plain text — passwords assigned this way are permanent
# (they clear must_change_password), so a committed sheet is a standing
# key to every account on it. Any spreadsheet anywhere in the repo is
# ignored; the roster imports read from packages/db/data/ above, which is
# ignored too, so nothing legitimate needs to be committed.
*.xlsx
*.xls
*.csv

